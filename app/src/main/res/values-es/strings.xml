    <string name="result_title">Resultado</string>
    <string name="result_heart">Corazón del resultado de amor</string>
    <string name="name_test_message_0_20">¡Deberían ser amigos, no enamorarse! Será la mejor relación de tu vida o perderás a esa persona para siempre. A veces, las mejores historias de amor son las que quedan sin decir entre mejores amigos</string>
    <string name="name_test_message_21_50">¡Más que amigos, deberíamos ser amores! ¡La historia de amor debería empezar a escribirse ahora! El amor es como el viento: no puedes verlo, pero puedes sentirlo.</string>
    <string name="name_test_message_51_80">¡Quiero abrazarte fuerte y sentir cómo nuestros corazones laten como uno solo para siempre! Tú lo llamas locura, yo lo llamo amor. Solo podemos aprender a amar amando</string>
    <string name="name_test_message_81_100">¡Nací para ser tu amor! ¡Eres la niña de mis ojos! Debemos pertenecernos a nosotros mismos antes de pertenecer a otro. Mi alma y la tuya están enredadas para siempre</string>
