<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearance.LoveTester.Circle"
        parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Back arrow. The 48dp size must be set in each layout (layout_* are not read from styles). -->
    <style name="Widget.LoveTester.BackButton" parent="">
        <item name="android:src">@drawable/ic_arrow_left</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">12dp</item>
        <item name="android:contentDescription">@string/common_back</item>
        <item name="tint">@color/text_body</item>
    </style>

    <!-- Text scale: 24 / 20 / 16 / 14 / 12 -->
    <style name="TextAppearance.LoveTester.LargeTitle" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textColor">@color/text_title</item>
    </style>

    <style name="TextAppearance.LoveTester.ScreenTitle" parent="">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textColor">@color/text_title</item>
    </style>

    <style name="TextAppearance.LoveTester.SheetTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textColor">@color/text_title</item>
    </style>

    <style name="TextAppearance.LoveTester.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textColor">@color/text_body</item>
    </style>

    <style name="TextAppearance.LoveTester.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="android:textColor">@color/text_body</item>
    </style>

    <style name="Widget.LoveTester.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="Widget.LoveTester.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

</resources>
