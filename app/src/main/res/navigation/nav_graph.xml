<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.lovetester.ui.splash.SplashFragment"
        android:label="Splash">

        <action
            android:id="@+id/action_splash_to_language"
            app:destination="@id/languageFragment" />
    </fragment>


    <fragment
        android:id="@+id/languageFragment"
        android:name="com.example.lovetester.ui.language.LanguageFragment"
        android:label="Language">

        <action
            android:id="@+id/action_language_to_intro"
            app:destination="@id/introFragment" />
    </fragment>

    <fragment
        android:id="@+id/introFragment"
        android:name="com.example.lovetester.ui.intro.IntroFragment"
        android:label="Intro"/>

</navigation>