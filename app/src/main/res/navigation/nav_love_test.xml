<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_love_test"
    app:startDestination="@id/loveTestFragment">

    <fragment
        android:id="@+id/loveTestFragment"
        android:name="com.example.lovetester.ui.lovetest.LoveTestFragment"
        android:label="Love Test">

        <action
            android:id="@+id/action_loveTest_to_nameTest"
            app:destination="@id/nameTestFragment" />

        <action
            android:id="@+id/action_loveTest_to_horoscopeTest"
            app:destination="@id/horoscopeTestFragment" />

    </fragment>

    <fragment
        android:id="@+id/nameTestFragment"
        android:name="com.example.lovetester.ui.lovetest.name.NameTestFragment"
        android:label="Name Test">

        <action
            android:id="@+id/action_nameTest_to_result"
            app:destination="@id/loveTestResultFragment" />

    </fragment>

    <fragment
        android:id="@+id/horoscopeTestFragment"
        android:name="com.example.lovetester.ui.lovetest.horoscope.HoroscopeTestFragment"
        android:label="Horoscope Test">

        <action
            android:id="@+id/action_horoscopeTest_to_result"
            app:destination="@id/loveTestResultFragment" />

    </fragment>

    <fragment
        android:id="@+id/loveTestResultFragment"
        android:name="com.example.lovetester.ui.lovetest.result.LoveTestResultFragment"
        android:label="Result">

        <argument
            android:name="personOne"
            app:argType="string" />

        <argument
            android:name="personTwo"
            app:argType="string" />

        <argument
            android:name="percentage"
            app:argType="integer" />

        <argument
            android:name="testType"
            app:argType="string"
            android:defaultValue="name" />

        <argument
            android:name="signOne"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

        <argument
            android:name="signTwo"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />

    </fragment>

</navigation>