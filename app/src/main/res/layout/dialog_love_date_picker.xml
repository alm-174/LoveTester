<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_love_date_dialog">

    <LinearLayout
        android:id="@+id/layoutCalendarHeader"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/btnPreviousMonth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@android:color/transparent"
            android:contentDescription="@string/date_picker_previous_month"
            app:tint="@color/primary"/>

        <TextView
            android:id="@+id/tvCalendarMonth"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            tools:text="December - 2023"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_calendar_month"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/date_picker_choose_year"/>

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@android:color/transparent"
            android:contentDescription="@string/date_picker_next_month"
            app:tint="@color/primary"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutWeekHeader"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutCalendarHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/date_picker_weekday_sun"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="@color/text_calendar_weekday"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/date_picker_weekday_mon"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="@color/text_calendar_weekday"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/date_picker_weekday_tue"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="@color/text_calendar_weekday"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/date_picker_weekday_wed"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="@color/text_calendar_weekday"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/date_picker_weekday_thu"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="@color/text_calendar_weekday"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/date_picker_weekday_fri"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="@color/text_calendar_weekday"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/date_picker_weekday_sat"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="@color/text_calendar_weekday"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalendarDays"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layoutWeekHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalendarYears"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="@id/layoutWeekHeader"
        app:layout_constraintBottom_toBottomOf="@id/rvCalendarDays"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutCalendarActions"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        app:layout_constraintTop_toBottomOf="@id/rvCalendarDays"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnCancelDate"
            style="@style/Widget.LoveTester.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:text="@string/common_cancel"/>

        <Button
            android:id="@+id/btnSaveDate"
            style="@style/Widget.LoveTester.Button.Filled"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:minWidth="88dp"
            android:text="@string/common_save"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>