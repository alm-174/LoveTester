<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/bg_love_date_dialog">

    <LinearLayout
        android:id="@+id/layoutCalendarHeader"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/btnPreviousMonth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@android:color/transparent"
            android:contentDescription="Previous month"
            app:tint="@color/color_ff0845"/>

        <TextView
            android:id="@+id/tvCalendarMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="December - 2023"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:textSize="@dimen/text_body"
            android:textColor="#27272A"/>

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@android:color/transparent"
            android:contentDescription="Next month"
            app:tint="@color/color_ff0845"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutWeekHeader"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutCalendarHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sun"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="#787B82"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Mon"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="#787B82"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tue"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="#787B82"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Wed"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="#787B82"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Thu"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="#787B82"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Fri"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="#787B82"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Sat"
            android:textSize="@dimen/text_body"
            android:fontFamily="@font/plus_jakarta_sans_regular"
            android:textColor="#787B82"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCalendarDays"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layoutWeekHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/layoutCalendarActions"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        app:layout_constraintTop_toBottomOf="@id/rvCalendarDays"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnCancelDate"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="#1E232E"
            android:background="@drawable/bg_date_cancel"
            app:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"/>

        <Button
            android:id="@+id/btnSaveDate"
            android:layout_width="80dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:text="Save"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:background="@drawable/bg_date_save"
            app:backgroundTint="@null"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="0dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>