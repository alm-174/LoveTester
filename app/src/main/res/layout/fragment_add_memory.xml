<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMemoryHeader"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="4dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.LoveTester.BackButton"
            android:contentDescription="@string/common_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvMemoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_memory_title"
            android:textAppearance="@style/TextAppearance.LoveTester.ScreenTitle"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutMemoryHeader"
        app:layout_constraintBottom_toTopOf="@id/btnSaveMemory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp">

            <!-- KHUNG CHỌN ẢNH -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMemoryPhoto"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/add_memory_photo_add"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_photo_placeholder"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivMemoryPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/add_memory_photo_preview" />

                    <LinearLayout
                        android:id="@+id/layoutAddPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_camera"
                            android:contentDescription="@null"
                            app:tint="@color/text_body" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/common_add_photo"
                            android:textSize="14sp"
                            android:textColor="@color/text_body"
                            android:fontFamily="@font/plus_jakarta_sans_medium" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- NHÃN TITLE -->
            <TextView
                android:id="@+id/tvTitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/add_memory_title_label"
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                app:layout_constraintTop_toBottomOf="@id/cardMemoryPhoto"
                app:layout_constraintStart_toStartOf="@id/cardMemoryPhoto" />

            <!-- Ô NHẬP TIÊU ĐỀ -->
            <EditText
                android:id="@+id/etMemoryTitle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_memory_input"
                android:hint="@string/add_memory_title_hint"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:singleLine="true"
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_hint"
                app:layout_constraintTop_toBottomOf="@id/tvTitleLabel"
                app:layout_constraintStart_toStartOf="@id/cardMemoryPhoto"
                app:layout_constraintEnd_toEndOf="@id/cardMemoryPhoto" />

            <!-- NHÃN DATE -->
            <TextView
                android:id="@+id/tvDateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/add_memory_date_label"
                android:textSize="14sp"
                android:textColor="@color/text_title"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                app:layout_constraintTop_toBottomOf="@id/etMemoryTitle"
                app:layout_constraintStart_toStartOf="@id/cardMemoryPhoto" />

            <!-- Ô CHỌN NGÀY -->
            <LinearLayout
                android:id="@+id/layoutMemoryDate"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_memory_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/add_memory_select_date"
                app:layout_constraintTop_toBottomOf="@id/tvDateLabel"
                app:layout_constraintStart_toStartOf="@id/cardMemoryPhoto"
                app:layout_constraintEnd_toEndOf="@id/cardMemoryPhoto">

                <TextView
                    android:id="@+id/tvMemoryDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/common_select_date"
                    android:textColor="@color/text_hint"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_nav_memory"
                    android:contentDescription="@null"
                    app:tint="@color/text_body" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvMemoryFormError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/text_error"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/layoutMemoryDate"
                app:layout_constraintStart_toStartOf="@id/layoutMemoryDate"
                app:layout_constraintEnd_toEndOf="@id/layoutMemoryDate" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- NÚT SAVE -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveMemory"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/common_save"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:fontFamily="@font/plus_jakarta_sans_medium"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
