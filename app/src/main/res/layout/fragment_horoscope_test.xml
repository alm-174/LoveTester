<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_left"
        android:contentDescription="@string/common_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/horoscope_test_title"
        android:textSize="20sp"
        android:textColor="@color/text_title"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <LinearLayout
        android:id="@+id/layoutZodiacPair"
        android:layout_width="313dp"
        android:layout_height="148dp"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:gravity="top|center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- CUNG CỦA BẠN -->
        <LinearLayout
            android:id="@+id/layoutYourZodiac"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_zodiac_circle">

                <ImageView
                    android:id="@+id/ivYourZodiac"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:src="@drawable/zodiac_aries"
                    android:contentDescription="@string/horoscope_test_your_zodiac" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvYourZodiac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                tools:text="Aries"
                android:textSize="17sp"
                android:textColor="@color/text_body"
                android:fontFamily="@font/plus_jakarta_sans_semibold" />

        </LinearLayout>

        <!-- VÔ CỰC -->
        <ImageView
            android:id="@+id/ivInfinity"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="23dp"
            android:src="@drawable/ic_love_infinity"
            android:scaleType="fitCenter"
            android:contentDescription="@string/common_love_infinity" />

        <!-- CUNG ĐỐI PHƯƠNG -->
        <LinearLayout
            android:id="@+id/layoutPartnerZodiac"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_zodiac_circle">

                <ImageView
                    android:id="@+id/ivPartnerZodiac"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    android:src="@drawable/zodiac_aries"
                    android:contentDescription="@string/horoscope_test_partner_zodiac" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvPartnerZodiac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                tools:text="Aries"
                android:textSize="17sp"
                android:textColor="@color/text_body"
                android:fontFamily="@font/plus_jakarta_sans_semibold" />

        </LinearLayout>

    </LinearLayout>


    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLoveTest"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0"
        android:stateListAnimator="@null"
        android:text="@string/horoscope_test_button_love_test"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:backgroundTint="@color/primary"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
