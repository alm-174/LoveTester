<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_arrow_left"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Result"
        android:textSize="22sp"
        android:textColor="#202532"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/layoutResultHeart"
        android:layout_width="212dp"
        android:layout_height="190dp"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivResultHeart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/love_heart"
            android:scaleType="fitXY"
            android:contentDescription="Love result heart" />

        <TextView
            android:id="@+id/tvPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="20%"
            android:textSize="48sp"
            android:textColor="@android:color/white"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutPersons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layoutResultHeart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPersonOne"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:src="@drawable/avatar_sasuke"
                android:scaleType="fitCenter"
                android:contentDescription="Person one avatar" />

            <TextView
                android:id="@+id/tvPersonOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Sasuke"
                android:textSize="16sp"
                android:textColor="#444955"
                android:fontFamily="@font/plus_jakarta_sans_semibold" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivInfinity"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="12dp"
            android:src="@drawable/ic_love_infinity"
            android:contentDescription="Love infinity" />

        <LinearLayout
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPersonTwo"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:src="@drawable/avatar_naruto"
                android:scaleType="fitCenter"
                android:contentDescription="Person two avatar" />

            <TextView
                android:id="@+id/tvPersonTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Naruto"
                android:textSize="16sp"
                android:textColor="#444955"
                android:fontFamily="@font/plus_jakarta_sans_semibold" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvResultMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_result_message"
        android:padding="14dp"
        android:textColor="#202532"
        android:textSize="17sp"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:text="Your love test result message"
        app:layout_constraintTop_toBottomOf="@id/layoutPersons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
