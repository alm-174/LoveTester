<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <TextView
        android:id="@+id/tvPermissionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Permission"
        android:textSize="20sp"
        android:textColor="@color/color_1e232e"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:layout_marginStart="@dimen/space_16"
        android:layout_marginTop="@dimen/space_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivPermissionHeart"
        android:layout_width="200dp"
        android:layout_height="176dp"
        android:src="@drawable/permission_heart"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@id/tvPermissionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPermissionDescription"
        android:layout_width="253dp"
        android:layout_height="wrap_content"
        android:text="@string/permission_decription"
        android:textSize="14sp"
        android:textColor="#4B4F58"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:gravity="center"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/ivPermissionHeart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutAllowAccess"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="22dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/bg_language_unselected"
        app:layout_constraintTop_toBottomOf="@id/tvPermissionDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvAllowAccess"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Allow access"
            android:textColor="#4B4F58"
            android:textSize="16sp"
            android:fontFamily="@font/plus_jakarta_sans_semibold" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAllowAccess"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:showText="false"
            app:thumbTint="@color/color_ff0845"
            app:trackTint="@color/color_4dff4081" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnContinue"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="80dp"
        android:layout_marginTop="66dp"
        android:gravity="center"
        android:text="Continue"
        android:textSize="18sp"
        android:textColor="@color/color_ff0845"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/layoutAllowAccess"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>