<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutBottomNav"
    android:layout_width="match_parent"
    android:layout_height="67dp"
    android:orientation="horizontal"
    android:gravity="center">

    <!-- Home -->
    <LinearLayout
        android:id="@+id/navHome"
        android:contentDescription="@string/nav_home_tab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:id="@+id/ivNavHome"
            android:src="@drawable/ic_nav_home"
            android:contentDescription="@string/nav_home"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:id="@+id/tvNavHome"
            android:text="@string/nav_home"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:textColor="@color/primary" />

    </LinearLayout>
    <!-- Love test -->
    <LinearLayout
        android:id="@+id/navLoveTest"
        android:contentDescription="@string/nav_love_test_tab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:id="@+id/ivNavLoveTest"
            android:src="@drawable/ic_nav_love_test"
            android:contentDescription="@string/nav_love_test"
            app:tint="@color/text_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:id="@+id/tvNavLoveTest"
            android:text="@string/nav_love_test"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:textColor="@color/text_body" />

    </LinearLayout>
    <!-- Memory -->

    <LinearLayout
        android:id="@+id/navMemory"
        android:contentDescription="@string/nav_memory_tab"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:id="@+id/ivNavMemory"
            android:src="@drawable/ic_nav_memory"
            android:contentDescription="@string/nav_memory"
            app:tint="@color/text_body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:id="@+id/tvNavMemory"
            android:text="@string/nav_memory"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans_semibold"
            android:textColor="@color/text_body" />

    </LinearLayout>

</LinearLayout>
