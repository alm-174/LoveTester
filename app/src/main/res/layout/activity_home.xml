<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 1. Ảnh nền phía trên -->
    <ImageView
        android:id="@+id/ivHomeBackground"
        android:layout_width="0dp"
        android:layout_height="369dp"
        android:src="@drawable/home_background"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Nền trắng và mây hồng -->
    <ImageView
        android:id="@+id/ivHomeContentBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="316dp"
        android:src="@drawable/home_couple_background"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivCouple"
        android:layout_width="260dp"
        android:layout_height="200dp"
        android:src="@drawable/home_couple"
        android:scaleType="fitCenter"
        android:contentDescription="@string/home_couple_illustration"
        android:layout_marginTop="230dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Nút Settings -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="47dp"
        android:src="@drawable/ic_settings"
        android:background="@android:color/transparent"
        android:contentDescription="@string/home_settings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 4. Nút Gallery -->
    <ImageButton
        android:id="@+id/btnGallery"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="47dp"
        android:src="@drawable/ic_gallery"
        android:background="@android:color/transparent"
        android:contentDescription="@string/home_gallery"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutCoupleInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivCouple"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Cột trái -->
        <LinearLayout
            android:id="@+id/layoutPersonOne"
        android:foreground="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPersonOne"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/avatar_sasuke"
                android:scaleType="centerCrop"
                android:contentDescription="@string/common_person_one_avatar"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.LoveTester.Circle" />

            <TextView
                android:id="@+id/tvPersonOneName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Sasuke"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:textColor="@android:color/black"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/ivPersonOneGender"
                    android:layout_width="@dimen/space_16"
                    android:layout_height="@dimen/space_16"
                    android:src="@drawable/male"
                    android:contentDescription="@string/common_gender_male" />

                <TextView
                    android:id="@+id/tvPersonOneAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    tools:text="26"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textSize="18sp"
                    android:textColor="@color/text_body" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutLoveDays"
        android:foreground="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="65dp">

                <ImageView
                    android:id="@+id/ivLoveDaysHeart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/love_heart"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/home_love_days_heart" />

                <TextView
                    android:id="@+id/tvLoveDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    tools:text="0\nDay"
                    android:textSize="16sp"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textColor="@android:color/white" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvStartDateHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_tap_to_start_date"
                android:fontFamily="@font/plus_jakarta_sans_regular"
                android:textSize="12sp"
                android:gravity="center"
                android:textColor="@color/text_body" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPersonTwo"
        android:foreground="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPersonTwo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/avatar_naruto"
                android:scaleType="centerCrop"
                android:contentDescription="@string/common_person_two_avatar"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.LoveTester.Circle" />

            <TextView
                android:id="@+id/tvPersonTwoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Naruto"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:textColor="@android:color/black"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/ivPersonTwoGender"
                    android:layout_width="@dimen/space_16"
                    android:layout_height="@dimen/space_16"
                    android:src="@drawable/female"
                    android:contentDescription="@string/common_gender_female" />

                <TextView
                    android:id="@+id/tvPersonTwoAge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    tools:text="26"
                    android:fontFamily="@font/plus_jakarta_sans_semibold"
                    android:textSize="18sp"
                    android:textColor="@color/text_body" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

    <include
        android:id="@+id/layoutBottomNav"
        layout="@layout/view_bottom_tabs"
        android:layout_width="0dp"
        android:layout_height="67dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/homeMemoryContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_splash"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/startDateContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
