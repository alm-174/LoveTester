<?xml version="1.0" encoding="utf-8"?>
<!-- Height: wraps content; HoroscopePickerBottomSheet caps it with BottomSheetBehavior.maxHeight. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/viewHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        style="@style/Widget.LoveTester.SheetHandle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_screen_horizontal"
        android:layout_marginTop="28dp"
        android:text="@string/horoscope_picker_title"
        android:textAppearance="@style/TextAppearance.LoveTester.SheetTitle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- wrap_content + constrainedHeight: the grid takes what it needs, but never more than the
         sheet allows, so it scrolls instead of being cut off. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvZodiac"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="@dimen/margin_screen_horizontal"
        android:layout_marginEnd="@dimen/margin_screen_horizontal"
        android:clipToPadding="false"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
